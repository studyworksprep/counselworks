# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# College Scorecard API (https://collegescorecard.ed.gov)
COLLEGE_SCORECARD_API_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=CounselWorks <noreply@yourdomain.com>

# Anthropic Claude API (AI essay assistance)
ANTHROPIC_API_KEY=

# Inngest (background jobs + the seven crons).
# /api/inngest is deliberately not Clerk-gated (src/middleware.ts) because
# Inngest Cloud has no session; request signing is therefore its ONLY
# protection. INNGEST_SIGNING_KEY must be set in any deployed environment.
# INNGEST_EVENT_KEY is what lets the app send events. Locally, run the Inngest
# dev server instead and set INNGEST_DEV=1.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
INNGEST_DEV=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
